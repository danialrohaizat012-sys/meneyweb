// Add inside existing /databases/{database}/documents block.
// Do not replace existing Firestore rules.
// Published records contain ONLY public fields; NEVER copy whole POS products.
// Owner can read unpublished drafts. Anonymous users can query only published records.
match /publicCatalogue/{productId} {
  allow get, list: if isOwner() || resource.data.published == true;
  allow create, update: if isOwner()
    && request.resource.data.keys().hasOnly([
      "name", "category", "brand", "condition", "price",
      "imageUrl", "available", "published", "updatedAt",
      "sourceProductId"
    ])
    && request.resource.data.keys().hasAll([
      "name", "price", "published", "sourceProductId"
    ])
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.price is number
    && request.resource.data.price >= 0
    && request.resource.data.published is bool
    && request.resource.data.sourceProductId == productId;
  allow delete: if isOwner();
}
// The public storefront query must include where("published","==",true).
// Test using Firestore Emulator before deploying to production.
// Existing /products, /customers, /inventoryUnits rules stay unchanged.
